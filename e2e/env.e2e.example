# Copy to `.env.e2e` in the project root (gitignored) and fill in.
# Accounts the end-to-end tests sign in with. Use dedicated test accounts,
# with a profiles row of the matching role, and strong passwords.

# Required: role super_admin (creates/removes the "E2E Test" department).
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=

# Optional: role admin. Without it the admin test is skipped.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional: role user. Without it the read-only test is skipped.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
